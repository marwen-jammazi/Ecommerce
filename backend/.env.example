NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
CLIENT_URL=http://localhost:5173
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
# ---- payments ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# currency Stripe charges in, and the multiplier from your store currency (TND) to it
STRIPE_CURRENCY=usd
STRIPE_RATE=0.32
FLOUCI_PUBLIC_KEY=xxx
FLOUCI_PRIVATE_KEY=xxx
# public URL of this API, needed for Flouci webhooks (use ngrok in dev, leave empty to skip the webhook)
API_PUBLIC_URL=
# unpaid online orders are cancelled and stock released after this many minutes
ORDER_PAYMENT_TIMEOUT_MIN=45
